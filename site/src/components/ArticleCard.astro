---
import type { CollectionEntry } from "astro:content";
import TagBadge from "./TagBadge.astro";

interface Props {
  article: CollectionEntry<"articles">;
  index?: number;
}
const { article, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = `${base}/articles/${article.id}`;
const dateStr = article.data.pubDate.toISOString().slice(0, 10);
---

<article class="card">
  <header class="head">
    {index !== undefined && <span class="num">{index}</span>}
    <h3>
      <a href={href}>{article.data.title}</a>
    </h3>
  </header>
  <div class="meta">
    <span>📌 {article.data.sourceName}</span>
    <span>📅 {dateStr}</span>
  </div>
  <p class="desc">{article.data.description}</p>
  <div class="tags">
    {article.data.tags.map((t: string) => <TagBadge slug={t} />)}
  </div>
</article>

<style>
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 16px 18px;
    margin-bottom: 16px;
    box-shadow: var(--shadow);
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 4px;
  }
  .num {
    display: inline-block;
    background: var(--accent);
    color: white;
    width: 24px;
    height: 24px;
    line-height: 24px;
    text-align: center;
    border-radius: 50%;
    font-size: 0.85em;
    font-weight: 700;
    flex-shrink: 0;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  h3 a {
    color: var(--text);
  }
  h3 a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .meta {
    color: var(--text-soft);
    font-size: 0.85rem;
    display: flex;
    gap: 14px;
    margin: 6px 0;
    flex-wrap: wrap;
  }
  .desc {
    margin: 10px 0;
    color: var(--text);
    font-size: 0.95rem;
  }
  .tags {
    margin-top: 10px;
  }
</style>
