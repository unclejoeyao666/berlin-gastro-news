---
import BaseLayout from "./BaseLayout.astro";
import AudioPlayer from "../components/AudioPlayer.astro";

interface Props {
  title: string;
  date: Date;
  audioUrl?: string;
  archived?: boolean;
}
const props = Astro.props;
const dateStr = props.date.toISOString().slice(0, 10);
const weekdays = ["日", "一", "二", "三", "四", "五", "六"];
const weekday = weekdays[props.date.getUTCDay()];
---

<BaseLayout
  title={props.title}
  description={`柏林餐饮商业新闻 ${dateStr} 期`}
  highlightDate={dateStr}
>
  <header class="brf-head">
    <p class="eyebrow">每日简报</p>
    <h1>{props.title}</h1>
    <p class="brf-date">
      <time>{dateStr}</time> · 星期{weekday}
    </p>
    {props.audioUrl && <AudioPlayer src={props.audioUrl} date={dateStr} />}
    {props.archived && (
      <aside class="archive-banner" role="note">
        <strong>归档说明</strong>
        <p>
          这一期为冷启动 / 测试期产物，内容不符合本站当前的「柏林餐饮商业」编辑标准，
          仅作为历史保留。请参考更新日期之后的简报。
        </p>
      </aside>
    )}
  </header>
  <div class="brf-body">
    <slot />
  </div>
</BaseLayout>

<style>
  .brf-head {
    padding: 8px 0 4px;
    border-bottom: 2px solid var(--text);
    margin-bottom: 24px;
  }
  .brf-head h1 {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    margin: 4px 0 6px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .brf-date {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 16px;
    font-family: var(--font-sans);
  }
  .brf-date time { font-family: var(--font-mono); }
  @media (max-width: 600px) {
    .brf-head h1 { font-size: 1.7rem; }
  }
  .archive-banner {
    background: var(--surface-tint, #fff5e0);
    border-left: 3px solid var(--gold, #c08810);
    padding: 12px 16px;
    margin: 12px 0 0;
    color: var(--text-muted, #555);
    font-size: 0.9rem;
    border-radius: 4px;
  }
  .archive-banner strong {
    display: block;
    color: var(--gold, #c08810);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 4px;
  }
  .archive-banner p { margin: 0; }
</style>
